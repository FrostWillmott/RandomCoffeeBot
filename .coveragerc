[run]
source = app
# python-coverage-comment-action reads .coverage directly and needs repo-relative
# paths to map lines back to files in the checkout.
relative_files = true
omit =
    */__pycache__/*
    */tests/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    ^\s*\.\.\.$
